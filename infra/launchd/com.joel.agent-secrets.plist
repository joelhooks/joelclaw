<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.joel.agent-secrets</string>

    <key>UserName</key>
    <string>joelclaw</string>

    <key>GroupName</key>
    <string>joelclaw-secrets</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>ProcessType</key>
    <string>Background</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/Shared/joelclaw/bin/secrets</string>
        <string>serve</string>
        <string>--no-update-check</string>
        <string>--config</string>
        <string>/Users/joelclaw/.agent-secrets/config.json</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/Shared/joelclaw</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/joelclaw</string>
        <key>PATH</key>
        <string>/Users/Shared/joelclaw/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/Shared/joelclaw/logs/agent-secrets.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/Shared/joelclaw/logs/agent-secrets.err</string>
</dict>
</plist>
