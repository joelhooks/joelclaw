# /etc/sudoers.d/joelclaw-central
#
# Lets joel (and therefore local agents running as joel) restart central
# services without a password. Exact commands only — no wildcards, because
# sudoers wildcards match across argument boundaries.
#
# Deliberately excluded: postgres, redis (stateful, restart has blast radius —
# add explicitly if wanted), and anything outside the central service set.
#
# Install with: sudo ./install-central-kickstart-sudoers.sh
#
# Executor is sudo-free by design (2026-09-28, joelclaw-central
# scripts/update-executor.sh): joel updates files under
# /Users/Shared/joelclaw/opt/executor via ACL, then restarts with the two
# executor kickstart lines below. They are load-bearing; do not remove them,
# and do not add a root install script here instead (a root process reading a
# joel-writable plist is a path to root).
joel ALL=(root) NOPASSWD: /bin/launchctl kickstart -k system/com.joelclaw.central.typesense
joel ALL=(root) NOPASSWD: /bin/launchctl kickstart -k system/com.joelclaw.central.inngest
joel ALL=(root) NOPASSWD: /bin/launchctl kickstart -k system/com.joelclaw.central.executor
joel ALL=(root) NOPASSWD: /bin/launchctl kickstart -k system/com.joelclaw.central.executor-dashboard
joel ALL=(root) NOPASSWD: /bin/launchctl kickstart -k system/com.joelclaw.central.session-index-health
joel ALL=(root) NOPASSWD: /bin/launchctl kickstart -k system/com.joel.system-bus-worker
