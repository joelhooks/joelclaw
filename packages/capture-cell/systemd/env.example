# Install as /etc/capture-intake/env, root-owned mode 0600. Replace placeholders.
CAPTURE_CELL_MODE=intake
CAPTURE_CELL_PORT=3114
CAPTURE_INTAKE_BIND=0.0.0.0
CAPTURE_INTAKE_DIR=/var/lib/capture-intake
CAPTURE_INTAKE_DB=/var/lib/capture-intake/intake.db
CAPTURE_INTAKE_BLOB_DIR=/var/lib/capture-intake/blobs
CAPTURE_INTAKE_TOKEN=REPLACE_WITH_INGEST_TOKEN
CAPTURE_INTAKE_PULL_TOKEN=REPLACE_WITH_DISTINCT_PULL_TOKEN
CAPTURE_INTAKE_USER_ID=REPLACE_WITH_EXISTING_CAPTURE_USER_ID
# Optional Central machine-token hashes. Install mode 0600, readable by capture-intake.
# CAPTURE_INTAKE_IDENTITIES_FILE=/etc/capture-intake/identities.json
